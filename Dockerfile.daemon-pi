FROM golang:1.26.1-alpine AS builder

RUN apk add --no-cache git
WORKDIR /src
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server/ ./server/

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
RUN cd server && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" -o /out/dars ./cmd/dars

FROM node:22.19.0-bookworm-slim

ARG PI_VERSION=0.84.2
ARG VERSION=dev
ARG COMMIT=unknown
ARG DARS_UID=1000
ARG DARS_GID=1000

LABEL org.opencontainers.image.title="DARS Pi Runtime Node" org.opencontainers.image.version="${VERSION}" org.opencontainers.image.revision="${COMMIT}" io.dars.pi.version="${PI_VERSION}"

RUN apt-get update && for attempt in 1 2 3 4 5; do if apt-get install -y --no-install-recommends bash ca-certificates git openssh-client ripgrep tini; then break; fi; [ "$attempt" -lt 5 ] || exit 1; done && rm -rf /var/lib/apt/lists/* && npm install --global --ignore-scripts --no-audit --no-fund "@earendil-works/pi-coding-agent@${PI_VERSION}" && test "$(node --version)" = "v22.19.0" && test "$(pi --version)" = "${PI_VERSION}" && npm cache clean --force

RUN set -eux; group_name="$(getent group "${DARS_GID}" | cut -d: -f1 || true)"; if [ -z "${group_name}" ]; then groupadd --gid "${DARS_GID}" dars; elif [ "${group_name}" != dars ]; then groupmod --new-name dars "${group_name}"; fi; user_name="$(getent passwd "${DARS_UID}" | cut -d: -f1 || true)"; if [ -z "${user_name}" ]; then useradd --uid "${DARS_UID}" --gid "${DARS_GID}" --create-home --home-dir /home/dars --shell /bin/bash dars; else if [ "${user_name}" != dars ]; then usermod --login dars "${user_name}"; fi; usermod --home /home/dars --move-home --gid "${DARS_GID}" --shell /bin/bash dars; fi; install -d -o "${DARS_UID}" -g "${DARS_GID}" /config/pi /home/dars/.dars /workspaces

COPY --from=builder /out/dars /usr/local/bin/dars
COPY --chmod=0755 docker/daemon-pi-entrypoint.sh /usr/local/bin/daemon-pi-entrypoint

ENV HOME=/home/dars PI_CODING_AGENT_DIR=/config/pi DARS_PI_PATH=/usr/local/bin/pi DARS_WORKSPACES_ROOT=/workspaces DARS_AGENT_RUNTIME_NAME="DARS Pi Runtime" DARS_PI_PREFLIGHT=basic

USER dars
WORKDIR /workspaces
VOLUME ["/home/dars/.dars", "/workspaces"]

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=4 CMD ["dars", "daemon", "container-health"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/daemon-pi-entrypoint"]
