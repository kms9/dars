# Lightweight PostgreSQL
POSTGRES_DB=dars_lightweight
POSTGRES_USER=dars
POSTGRES_PASSWORD=dars
POSTGRES_PORT=5432
DATABASE_URL=postgres://dars:dars@localhost:5432/dars_lightweight?sslmode=disable
EXPECTED_DATABASE_NAME=dars_lightweight
DARS_EDITION=lightweight
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_CONN_LIFETIME=300s

# Agent configuration encryption. Generate once per deployment with:
# openssl rand -base64 32
DARS_AGENT_SECRET_KEY=
DARS_AGENT_SECRET_KEY_ID=primary

# Server
APP_ENV=
PORT=8080
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:${FRONTEND_PORT}
JWT_SECRET=change-me-in-production
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=
DARS_APP_URL=${FRONTEND_ORIGIN}
DARS_PUBLIC_URL=
DARS_TRUSTED_PROXIES=
DARS_SHUTDOWN_HOLD_DURATION=
METRICS_ADDR=
LOG_LEVEL=info

# Server-side MCP Gateway. DARS_PUBLIC_URL is required only when a task
# claims a pinned ToolBundle. Private/VPC ranges remain denied unless listed.
DARS_MCP_PRIVATE_CIDR_ALLOWLIST=
DARS_MCP_ALLOWED_PORTS=80,443
DARS_MCP_CONNECT_TIMEOUT=5s
DARS_MCP_INVOCATION_TIMEOUT=30s
DARS_MCP_CHANNEL_IDLE_TIMEOUT=5m
DARS_MCP_MAX_REQUEST_BODY_BYTES=1048576
DARS_MCP_MAX_RESPONSE_BYTES=4194304
DARS_MCP_MAX_ARTIFACT_BYTES=16777216
DARS_MCP_MAX_REDIRECTS=3
DARS_MCP_TASK_CONCURRENCY=4
DARS_MCP_SOURCE_CONCURRENCY=8

# Development-only fixed email verification code. It is ignored in production.
# Local architecture validation: the Web login page auto-signs in as
# dev@local.test with this code (default in CONTRIBUTING / e2e is 424242)
# and creates a demo workspace when the account has none.
DARS_DEV_VERIFICATION_CODE=

# Email. SMTP takes precedence when SMTP_HOST is set; otherwise Resend is used.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@dars.ai
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=
SMTP_TLS_INSECURE=false
SMTP_EHLO_NAME=

# Optional authentication and workspace admission policy.
ALLOW_SIGNUP=true
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
DISABLE_WORKSPACE_CREATION=false
AUTH_TOKEN_TTL=2592000

# Optional Redis relay, token cache, and public-auth rate limiting.
REDIS_URL=
REDIS_DISABLE_CLIENT_NAME=false
RATE_LIMIT_AUTH=5
RATE_LIMIT_AUTH_VERIFY=20
RATE_LIMIT_TRUSTED_PROXIES=

# Local Daemon/CLI
DARS_SERVER_URL=ws://localhost:8080/ws
DARS_WORKSPACE_ID=
DARS_DAEMON_ID=
DARS_DAEMON_DEVICE_NAME=
DARS_DAEMON_POLL_INTERVAL=3s
DARS_DAEMON_HEARTBEAT_INTERVAL=15s
DARS_CODEX_PATH=codex
DARS_CODEX_ARGS=
DARS_CODEX_MODEL=
DARS_CODEX_SEMANTIC_INACTIVITY_TIMEOUT=10m
DARS_CODEX_HANDSHAKE_TIMEOUT=30s

# Frontend runtime proxy
REMOTE_API_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Self-host images
DARS_IMAGE_TAG=latest
DARS_BACKEND_IMAGE=ghcr.io/kms9/dars-backend
DARS_WEB_IMAGE=ghcr.io/kms9/dars-web
